# Application Settings
APP_NAME="Indian Financial Document Classification Engine"
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

# Security & JWT (Generate a 32+ byte cryptographically strong random string)
SECRET_KEY=b4a92e21b79f8c62d04f214e9127814b7324c4fcaea7d5f048dbe55b41fae019
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=doc_classifier
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/doc_classifier
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/doc_classifier

# Redis & ARQ Task Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# LLM Inference (llama.cpp server)
LLAMA_CPP_URL=http://localhost:8080/v1/chat/completions
LLAMA_MODEL_NAME=Llama-3.2-3B-Instruct
LLM_REQUEST_TIMEOUT_SECONDS=60.0

# OCR Engine Settings
PADDLE_OCR_USE_GPU=false
PADDLE_OCR_LANG=en

# Storage & Upload Limits
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=26214400

# Security Boundaries
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","0.0.0.0"]
RATE_LIMIT_DEFAULT="60/minute"
RATE_LIMIT_UPLOAD="10/minute"
