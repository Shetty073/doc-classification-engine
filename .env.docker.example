# ==============================================================================
# DOCKER STACK CONFIGURATION VARIABLES
# Copy to .env or pass directly to docker compose
# ==============================================================================

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doc_classifier
POSTGRES_PORT=5432

# Redis Queue Settings
REDIS_PORT=6379

# Service Scaling & Instance Counts
BACKEND_PORT=8000
BACKEND_REPLICAS=1

WORKER_REPLICAS=2

FRONTEND_PORT=5173
FRONTEND_REPLICAS=1

# Classifier Engine Mode (llm or vlm)
CLASSIFIER_MODE=llm

# llama.cpp Model & Execution Attributes (Full Stack)
LLAMA_PORT=8080
LLAMA_MODEL_PATH=/models/Llama-3.2-3B-Instruct-Q4_K_M.gguf
LLAMA_MODEL_NAME=Llama-3.2-3B-Instruct
LLAMA_CTX_SIZE=4096
LLAMA_N_GPU_LAYERS=0
LLAMA_THREADS=4
LLAMA_BATCH_SIZE=512
LLAMA_TEMPERATURE=0.05
LLAMA_EXTRA_ARGS=

# Vision-Language Model (VLM) Settings (Full Stack or External)
VLM_URL=http://localhost:8080/v1/chat/completions
VLM_MODEL_NAME=Qwen2-VL-7B-Instruct
VLM_REQUEST_TIMEOUT_SECONDS=60.0
VLM_MAX_IMAGE_PAGES=3

# Storage Limits
MAX_ARCHIVE_UNCOMPRESSED_BYTES=209715200
